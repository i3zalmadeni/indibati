# انضباطي: متغيرات البيئة النموذجية. لا تضع القيم الحقيقية في المستودع.
# الواجهة (site/assets/config.js) تستخدم فقط المفتاح العام publishable. الأسرار تُحفظ في Supabase › Edge Functions › Secrets.

# Supabase (قاعدة النواة الرقمية)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# لدوال الحافة فقط (المرحلة السادسة: الإشعارات). لا يُستخدم في المتصفح أبداً.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business (Meta Cloud API) — المرحلة السادسة
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# التطوير المحلي (tests/run.sh وtests/e2e)
PGHOST=/tmp/pg
PGPORT=5544
PGDATABASE=indibati_e2e
